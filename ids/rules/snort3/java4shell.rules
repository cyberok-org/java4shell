# Adapted from jsik22/java4shell-detection, commit e7d3ddb (MIT).
# Experimental, alert-only indicators. See ../../README.md and ../../LICENSE.
alert http any any -> any any ( msg:"LOCAL Java4Shell CVE-2026-114938 malformed Base64 tail in Authorization Basic"; flow:to_server,established; http_header:field authorization; content:"Basic",fast_pattern,nocase; pcre:"/Basic\s+(?:[A-Za-z0-9+\/]{4}){8,}(?:={1,3}|[A-Za-z0-9+\/]={1,2}|[A-Za-z0-9+\/]{2}=)(?![A-Za-z0-9+\/_=-])/i"; classtype:attempted-admin; sid:9114938; rev:3; )
alert http any any -> any any ( msg:"LOCAL Java4Shell CVE-2026-114938 malformed Base64 tail in Authorization Bearer"; flow:to_server,established; http_header:field authorization; content:"Bearer",fast_pattern,nocase; pcre:"/Bearer\s+(?:[^\s.]*\.)*(?:[A-Za-z0-9+\/_-]{4}){8,}(?:={1,3}|[A-Za-z0-9+\/_-]={1,2}|[A-Za-z0-9+\/_-]{2}=)(?![A-Za-z0-9+\/_=-])/i"; classtype:attempted-admin; sid:9114939; rev:2; )
alert http any any -> any any ( msg:"LOCAL Java4Shell CVE-2026-114938 malformed Base64 tail in URL query"; flow:to_server,established; http_raw_uri; content:"=",fast_pattern; pcre:"/[?&][^=&#]*=(?:(?:[A-Za-z0-9+\/_-]|%2[BbFf]){4}){8,}(?:(?:=|%3[Dd]){1,3}|(?:[A-Za-z0-9+\/_-]|%2[BbFf])(?:=|%3[Dd]){1,2}|(?:[A-Za-z0-9+\/_-]|%2[BbFf]){2}(?:=|%3[Dd]))(?=[&#]|$)/"; classtype:attempted-admin; sid:9114940; rev:1; )
alert http any any -> any any ( msg:"LOCAL Java4Shell CVE-2026-114938 HUNT malformed Base64 tail in request body"; flow:to_server,established; http_header; pcre:!"/^Content-Type:\s*application\/x-www-form-urlencoded(?:\x3b|\s|$)/mi"; http_client_body; content:"=",fast_pattern; pcre:"/(?:^|[=:\x22\s,\[])(?:(?:[A-Za-z0-9+\/_-]|%2[BbFf]){4}){8,}(?:(?:=|%3[Dd]){1,3}|(?:[A-Za-z0-9+\/_-]|%2[BbFf])(?:=|%3[Dd]){1,2}|(?:[A-Za-z0-9+\/_-]|%2[BbFf]){2}(?:=|%3[Dd]))(?=\x22(?!\s*:)|[&\s,}\]]|$)/"; classtype:attempted-admin; sid:9114941; rev:2; )
alert http any any -> any any ( msg:"LOCAL Java4Shell CVE-2026-114938 HUNT malformed Base64 tail in other request header"; flow:to_server,established; http_header; content:"=",fast_pattern; pcre:"/^(?!(?:Authorization|Proxy-Authorization|X-ProxiedEntitiesChain|SolrAuthV2|Host|User-Agent|Accept[A-Za-z-]*|Content-Type|Content-Length|Connection|Referer|Origin|Date|Cache-Control|Pragma|Upgrade|Upgrade-Insecure-Requests|Sec-Fetch-[A-Za-z]+|Sec-Ch-[A-Za-z-]+|DNT|TE|Priority)\s*:)[^:\r\n]+:[^\r\n]*?(?:(?<=:)\s*|(?<==)|(?<=[A-Za-z0-9] ))(?:[A-Za-z0-9+\/_-]{4}){8,}(?:={1,3}|[A-Za-z0-9+\/_-]={1,2}|[A-Za-z0-9+\/_-]{2}=)(?![A-Za-z0-9+\/_=-])/mi"; classtype:attempted-admin; sid:9114942; rev:2; )
alert http any any -> any any ( msg:"LOCAL Java4Shell CVE-2026-114938 HUNT malformed Base64 tail in Cookie"; flow:to_server,established; http_cookie; content:"=",fast_pattern; pcre:"/(?:^|\;)\s*[^=\;\s]+=(?:[A-Za-z0-9+\/_-]{4}){8,}(?:={1,3}|[A-Za-z0-9+\/_-]={1,2}|[A-Za-z0-9+\/_-]{2}=)(?=[\;\s]|$)/"; classtype:attempted-admin; sid:9114943; rev:2; )


# Additional product/parser-specific routes adapted from this pack.
alert http any any -> any any (msg:"LOCAL Java4Shell CVE-2026-114938 ApiKey malformed Base64 indicator"; flow:to_server,established; http_header:field authorization; content:"ApiKey",fast_pattern,nocase; pcre:"/^(?i:apikey)[ \t]+(?:[A-Za-z0-9+\/]{64})+(?:=|[A-Za-z0-9+\/]=|==|[A-Za-z0-9+\/]{2}=|[A-Za-z0-9+\/]==|===)[ \t]*\r?$/"; classtype:attempted-admin; sid:9114950; rev:1;)
alert http any any -> any any (msg:"LOCAL Java4Shell CVE-2026-114938 NiFi encoded proxy-chain element indicator"; flow:to_server,established; http_header; content:"X-ProxiedEntitiesChain|3a|",fast_pattern,nocase; pcre:"/^X-ProxiedEntitiesChain:[ \t]*(?:<[^<>\r\n]*>|<<[^<>\r\n]*>>)*<<(?:[A-Za-z0-9+\/]{64})+(?:=|[A-Za-z0-9+\/]=|==|[A-Za-z0-9+\/]{2}=|[A-Za-z0-9+\/]==|===)>>(?=<|[ \t]*\r?$)/mi"; classtype:attempted-admin; sid:9114951; rev:1;)
alert http any any -> any any (msg:"LOCAL Java4Shell CVE-2026-114938 SolrAuthV2 final signature indicator"; flow:to_server,established; http_header; content:"SolrAuthV2|3a|",fast_pattern,nocase; pcre:"/^SolrAuthV2:[ \t]*[^ \t\r\n]+(?:[ \t]+[^ \t\r\n]+)*[ \t]+(?:[A-Za-z0-9+\/]{64})+(?:=|[A-Za-z0-9+\/]=|==|[A-Za-z0-9+\/]{2}=|[A-Za-z0-9+\/]==|===)[ \t]*\r?$/mi"; classtype:attempted-admin; sid:9114952; rev:1;)
alert http any any -> any any (msg:"LOCAL Java4Shell CVE-2026-114938 Proxy Basic malformed Base64 indicator"; flow:to_server,established; http_header:field proxy-authorization; content:"Basic",fast_pattern,nocase; pcre:"/^(?i:basic)[ \t]+(?:[A-Za-z0-9+\/]{64})+(?:=|[A-Za-z0-9+\/]=|==|[A-Za-z0-9+\/]{2}=|[A-Za-z0-9+\/]==|===)[ \t]*\r?$/"; classtype:attempted-admin; sid:9114953; rev:1;)
alert http any any -> any any (msg:"LOCAL Java4Shell CVE-2026-114938 HUNT form value indicator"; flow:to_server,established; http_header; pcre:"/^Content-Type:\s*application\/x-www-form-urlencoded(?:\x3b|\s|$)/mi"; http_client_body; content:"=",fast_pattern; pcre:"/(?:^|&)[^=&]*=(?:(?:[A-Za-z0-9+\/_-]|%2[BbFf]){4}){8,}(?:(?:=|%3[Dd]){1,3}|(?:[A-Za-z0-9+\/_-]|%2[BbFf])(?:=|%3[Dd]){1,2}|(?:[A-Za-z0-9+\/_-]|%2[BbFf]){2}(?:=|%3[Dd]))(?=&|$)/"; classtype:attempted-admin; sid:9114954; rev:1;)
